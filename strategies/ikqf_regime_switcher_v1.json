{
  "mode": "spot_only",
  "base_assets": [
    "USDT"
  ],
  "quote_policy": {
    "start_from": "USDT",
    "return_to": "USDT_on_exit",
    "no_shorting": true,
    "no_leverage": true,
    "max_open_strategy": 1
  },
  "universe_selection": {
    "source": "eligible_bep20_allowlist_or_top_liquid_bsc_tokens",
    "max_candidates": 50,
    "filters": {
      "min_24h_volume_usd": 20000000,
      "max_spread_pct": 0.35,
      "min_liquidity_usd": 500000,
      "stablecoins_excluded_as_trade_targets": true,
      "reject_new_or_unknown_tokens": true,
      "reject_if_major_negative_news": true
    }
  },
  "global_risk": {
    "max_daily_drawdown_pct": 5.0,
    "max_total_drawdown_pct": 12.0,
    "pause_after_loss_minutes": 60,
    "kill_to_usdt_on_panic": true,
    "max_deployed_fraction": {
      "safe": 0.25,
      "balanced": 0.4,
      "aggressive": 0.6
    }
  },
  "strategy_id": "ikqf_regime_switcher_v1",
  "name": "IKQF Regime Switcher",
  "version": "1.0.0",
  "description": "Meta-strategy that chooses which strategy to run based on market regime: trend, range, mean reversion, breakout, grid, or USDT flat.",
  "scan_interval_minutes": 5,
  "regime_classifier": {
    "inputs": [
      "btc_trend",
      "market_breadth",
      "top20_volatility",
      "fear_and_greed",
      "volume_expansion",
      "range_compression",
      "relative_strength_dispersion"
    ],
    "states": [
      "bull_trend",
      "bear_trend",
      "range",
      "high_volatility_panic",
      "low_volatility_compression",
      "rotation_market"
    ]
  },
  "strategy_routing": {
    "bull_trend": "ikqf_trend_pullback_v1_or_ikqf_momentum_breakout_v1",
    "range": "ikqf_adaptive_grid_plus_v1_or_ikqf_top_loser_reversal_v1",
    "rotation_market": "ikqf_relative_strength_rotation_v1",
    "low_volatility_compression": "wait_for_breakout_or_stay_USDT",
    "bear_trend": "stay_USDT",
    "high_volatility_panic": "kill_to_USDT"
  },
  "entry_rules": [
    "selected_strategy_entry_rules_pass",
    "confidence_score_above_strategy_threshold",
    "expected_edge_after_fees_positive"
  ],
  "exit_rules": [
    "selected_strategy_exit_rules_trigger",
    "regime_changes_against_position",
    "global_risk_limit_hit",
    "better_strategy_selected_after_costs"
  ],
  "risk_management": {
    "max_strategy_switches_per_day": 6,
    "cooldown_after_switch_minutes": 30,
    "max_deployed_fraction": {
      "safe": 0.2,
      "balanced": 0.35,
      "aggressive": 0.5
    },
    "hard_stop_loss_pct": {
      "safe": -3.0,
      "balanced": -5.0,
      "aggressive": -7.0
    }
  }
}